# =============================================================================
# Horizon PRM — Android Release Signing Configuration Template
#
# USAGE:
#   1. Copy this file:  cp keystore.properties.example keystore.properties
#   2. Fill in the values below
#   3. keystore.properties is gitignored — NEVER commit it
#
# KEYSTORE GENERATION (one-time setup):
#   keytool -genkey -v \
#     -keystore keystore.jks \
#     -keyalg RSA -keysize 4096 \
#     -validity 10000 \
#     -alias horizon \
#     -dname "CN=Horizon PRM, OU=Mobile, O=Horizon, L=, ST=, C=US"
#
# CI/CD (GitHub Actions / equivalent):
#   Set these as repository secrets instead of using this file:
#     KEYSTORE_FILE_BASE64   — base64-encoded keystore.jks
#     KEYSTORE_PASSWORD      — store password
#     KEY_ALIAS              — key alias (e.g. horizon)
#     KEY_PASSWORD           — key password
#   The CI workflow decodes KEYSTORE_FILE_BASE64 to a temp file and sets
#   KEYSTORE_FILE to its absolute path before running assembleRelease.
# =============================================================================

# Path to the keystore file, relative to android/ (the Gradle project root).
# Example: keystore.jks  →  file lives at  android/keystore.jks
KEYSTORE_FILE=keystore.jks

# Password used when the keystore was created (-storepass)
KEYSTORE_PASSWORD=CHANGE_ME

# Alias of the key entry inside the keystore (-alias)
KEY_ALIAS=horizon

# Password for the specific key entry (-keypass)
KEY_PASSWORD=CHANGE_ME
