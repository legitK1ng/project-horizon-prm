# ==========================================
# Horizon PRM — .gitignore
# ==========================================

# ── Logs ──────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server_log*.txt
server_crash_log*.txt
startup.log
out*.txt
lt_out*.txt
final_test*.txt
lint_errors.txt
tsc_output*.txt

# ── Runtime data ──────────────────────────
pids
*.pid
*.seed
*.pid.lock

# ── Coverage ──────────────────────────────
coverage/
*.lcov
lib-cov
.nyc_output

# ── Build outputs ─────────────────────────
dist/
build/Release
.next/
out/
.nuxt/

# ── Dependency directories ────────────────
node_modules/
jspm_packages/

# ── TypeScript ────────────────────────────
typings/
*.tsbuildinfo

# ── Test artifacts (generated, not source) ─
playwright-report/
test-results/

# ── Environment / Secrets ─────────────────
.env
.env.local
.env.test
.env.production
mcp-backend/.env
mcp_config.json

# ── Python ────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
mcp-backend/venv/
mcp-backend/.venv/
.venv/
.pytest_cache/
*.egg-info/

# ── IDE / Editor ──────────────────────────
.vscode-test
.idea/

# ── Cache dirs ────────────────────────────
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.fusebox/
.dynamodb/
.grunt
.npm
.eslintcache
.stylelintcache
.vite/

# ── Yarn v2 ───────────────────────────────
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ── OS ────────────────────────────────────
.DS_Store
Thumbs.db

# ── Misc temp/scratch files ───────────────
*.n8n
test_audio.wav
test_connect.js
mcp-backend/test_agent5.py
# ── Agent Data ────────────────────────────
.claude/
