# 🪐 PROJECT HORIZON: CONFIGURATION
# ──────────────────────────────────────────────────────────────────
# Copy this to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit secrets.

# ── Supabase (Direct Client) ──────────────────────────────────────
# ⚠️  PENDING: Replace with your actual Supabase port once confirmed.
# Common values: 54321 (Supabase default) or 8000 (Kong gateway).
# For mobile builds, prefix with the Tailscale Funnel URL:
#   https://hp-z2g3-mini-workstation.tailb79f25.ts.net:<PORT>
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key      # Supabase dashboard → Settings → API

# ── FastAPI / Transcription Backend (Tailscale Funnel — LIVE) ────
# Local dev uses localhost; native mobile builds use the Funnel URL.
VITE_BACKEND_URL=http://localhost:8000
VITE_BACKEND_URL_MOBILE=https://hp-z2g3-mini-workstation.tailb79f25.ts.net

# ── Horizon API Key (Bearer token for transcription endpoint) ────
# Used in Authorization header for /v1/audio/transcriptions
# ⚠️  Rotate this key if the conversation log is shared externally.
VITE_HZN_API_KEY=hzn_XXXX_REPLACE_WITH_ROTATED_KEY

# ── Google OAuth ──────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── ACR Ingestion ─────────────────────────────────────────────────
VITE_ACR_INGEST_ENDPOINT=/api/v1/calls/ingest
